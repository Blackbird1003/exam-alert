// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @map("email")
  password  String   @map("password")
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at")
  updatedAt DateTime @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  @@map("admins")
}

model Student {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  matricNumber String   @unique @map("matric_number")
  phone        String   @map("phone")
  email        String   @unique @map("email")
  faculty      String   @map("faculty")
  department   String   @map("department")
  level        String   @map("level")
  password     String   @map("password")
  createdAt    DateTime @default(dbgenerated("now()")) @map("created_at")
  updatedAt    DateTime @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  notifications Notification[]

  @@map("students")
}

model Faculty {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @map("name")
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at")
  updatedAt DateTime @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  facultyHalls FacultyHall[]
  timeTables   TimeTable[]

  @@map("faculties")
}

model FacultyHall {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @map("name")
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  facultyId   String   @map("faculty_id") @db.Uuid
  maxCapacity Int      @map("max_capacity")
  createdAt   DateTime @default(dbgenerated("now()")) @map("created_at")
  updatedAt   DateTime @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  timeTableCourses TimeTableCourse[]
  examSessions     CourseExamSession[]

  @@map("faculty_halls")
}

model TimeTable {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @map("name")
  faculty       Faculty   @relation(fields: [facultyId], references: [id])
  facultyId     String    @map("faculty_id") @db.Uuid
  semester      Semester  @map("semester")
  session       String    @map("session")
  examStartDate DateTime? @map("exam_start_date")
  createdAt     DateTime  @default(dbgenerated("now()")) @map("created_at")
  updatedAt     DateTime  @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  courses TimeTableCourse[]

  @@map("time_tables")
}

model TimeTableCourse {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timeTableId      String    @map("time_table_id") @db.Uuid
  courseCode       String    @map("course_code")
  courseTitle      String    @map("course_title")
  courseUnit       Int       @map("course_unit")
  numberOfStudents Int       @map("number_of_students")
  examDate         DateTime? @map("exam_date")
  examTime         String?   @map("exam_time")
  duration         Int?      @map("duration")
  hallId           String?   @map("hall_id") @db.Uuid
  createdAt        DateTime  @default(dbgenerated("now()")) @map("created_at")
  updatedAt        DateTime  @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  timeTable    TimeTable           @relation(fields: [timeTableId], references: [id])
  hall         FacultyHall?        @relation(fields: [hallId], references: [id])
  examSessions CourseExamSession[]

  @@map("time_table_courses")
}

model CourseExamSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  hallId           String   @map("hall_id") @db.Uuid
  examDate         DateTime @map("exam_date")
  examTime         String   @map("exam_time")
  duration         Int      @map("duration")
  studentsAssigned Int      @map("students_assigned")
  sessionNumber    Int      @map("session_number") // 1 for first session, 2 for second, etc.
  createdAt        DateTime @default(dbgenerated("now()")) @map("created_at")
  updatedAt        DateTime @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  course TimeTableCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  hall   FacultyHall     @relation(fields: [hallId], references: [id])

  @@unique([courseId, sessionNumber])
  @@map("course_exam_sessions")
}

enum Semester {
  FIRST
  SECOND
}

enum NotificationType {
  SCHEDULE
  REMINDER
  CHANGE
  EMERGENCY
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType @map("type")
  subject     String           @map("subject")
  message     String           @map("message")
  status      String           @default("pending") @map("status") // pending, sent, delivered, failed
  sentAt      DateTime?        @map("sent_at")
  createdAt   DateTime         @default(dbgenerated("now()")) @map("created_at")
  updatedAt   DateTime         @default(dbgenerated("now()")) @updatedAt @map("updated_at")

  recipient Student @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
